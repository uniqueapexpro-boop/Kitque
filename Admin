async function saveProduct(existing){
  const err = document.getElementById('pfErr'); err.textContent = '';
  const title = document.getElementById('pf_title').value.trim();
  const desc = document.getElementById('pf_desc').value.trim();
  const price = parseFloat(document.getElementById('pf_price').value);
  const mrpRaw = document.getElementById('pf_mrp').value.trim();
  const mrp = mrpRaw ? parseFloat(mrpRaw) : null;
  const stock = parseInt(document.getElementById('pf_stock').value) || 0;
  const categoryId = document.getElementById('pf_cat').value || null;
  const isBest = document.getElementById('pf_best').checked;
  const hasSizes = document.getElementById('pf_hassize').checked;
  const sizes = hasSizes ? document.getElementById('pf_sizes').value.split(',').map(s=>s.trim()).filter(Boolean) : [];
  const rawImgs = [0,1,2,3,4].map(i=>document.getElementById('pf_img'+i).value.trim());
  const thumbRadio = document.querySelector('input[name=pf_thumb]:checked');
  const thumbIdx = thumbRadio ? parseInt(thumbRadio.value) : 0;
  const thumbVal = rawImgs[thumbIdx];
  let imgs = rawImgs.filter(Boolean);
  if(thumbVal){ imgs = [thumbVal, ...imgs.filter(u=>u!==thumbVal)]; }

  if(!title || !price || price<=0){ err.textContent="Enter a title and a valid selling price."; return; }
  if(mrp && mrp<price){ err.textContent="Cut price (MRP) should be higher than the selling price."; return; }
  if(hasSizes && sizes.length===0){ err.textContent="Add at least one size, or untick 'has sizes'."; return; }
  if(imgs.length===0){ err.textContent="Add at least one product image link."; return; }

  const payload = { title, description: desc, price, mrp, stock, category_id: categoryId,
    is_bestseller: isBest, has_sizes: hasSizes, sizes, images: imgs, seller_id: session.user.id };
  const btn = document.getElementById('pfSaveBtn'); btn.disabled = true;
  try{
    if(existing){
      await pgFetch(`products?id=eq.${existing.id}`, {method:"PATCH", headers:{"Prefer":"return=minimal"}, body: JSON.stringify(payload)});
      toast("Product updated.");
    } else {
      await pgFetch("products", {method:"POST", headers:{"Prefer":"return=minimal"}, body: JSON.stringify(payload)});
      toast("Product added.");
    }
    editingProductId = null;
    await loadProducts(); renderTab();
  }catch(e){ err.textContent = "Couldn't save: " + e.message; btn.disabled = false; }
}

