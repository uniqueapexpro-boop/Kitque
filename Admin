function applyOrderFilters(){
  const product = document.getElementById('fltProduct').value;
  const status = document.getElementById('fltStatus').value;
  const from = document.getElementById('fltFrom').value;
  const to = document.getElementById('fltTo').value;
  const q = document.getElementById('fltSearch').value.trim().toLowerCase();
  filteredOrders = allOrders.filter(o=>{
    if(product && o.product_title !== product) return false;
    if(status && o.status !== status) return false;
    const created = new Date(o.created_at);
    if(from && created < new Date(from+'T00:00:00')) return false;
    if(to && created > new Date(to+'T23:59:59')) return false;
    if(q){
      const hay = `${o.order_code} ${o.buyer_name} ${o.mobile} ${o.product_title}`.toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });
  renderOrdersTable();
}

