        <input type="text" id="slSearch" placeholder="Search name, email, mobile…">
      </div>
      <div class="table-scroll" id="accountsTableWrap"></div>
    </div>
  `;
  renderAccountsTable(profiles);
  document.getElementById('slSearch').addEventListener('input', e=>{
    const q = e.target.value.trim().toLowerCase();
    renderAccountsTable(q ? profiles.filter(p=>`${p.name||''} ${p.email||''} ${p.mobile||''}`.toLowerCase().includes(q)) : profiles);
  });
  document.getElementById('slSaveBtn').addEventListener('click', async ()=>{
    const email = document.getElementById('sl_email').value.trim();
    const role = document.getElementById('sl_role').value;
    const err = document.getElementById('slErr'); err.textContent = '';
    if(!email){ err.textContent = "Enter an email."; return; }
    try{
      const rows = await pgFetch(`profiles?email=eq.${encodeURIComponent(email)}`, {method:"PATCH", headers:{"Prefer":"return=representation"}, body: JSON.stringify({role})});
      if(!rows || rows.length===0) throw new Error("No account found with that email.");
      toast("Role updated."); renderTab();
    }catch(e){ err.textContent = e.message; }
  });
}

function renderAccountsTable(profiles){
  const wrap = document.getElementById('accountsTableWrap');
  wrap.innerHTML = `
    <table class="data-table">
      <thead><tr><th>Name</th><th>Email</th><th>Mobile</th><th>Role</th><th>Joined</th></tr></thead>
      <tbody>
        ${profiles.map(p=>`<tr>
          <td>${escapeHtml(p.name||'—')}</td>
          <td class="mono">${escapeHtml(p.email||'—')}</td>
          <td class="mono">${escapeHtml(p.mobile||'—')}</td>
          <td><span class="pill" style="background:var(--panel2);color:var(--text);">${escapeHtml(p.role||'customer')}</span></td>
          <td class="mono">${new Date(p.created_at).toLocaleDateString()}</td>
        </tr>`).join('')}
      </tbody>
    </table>
  `;
}

/* ---------------- settings tab ---------------- */
async function renderSettingsTab(wrap){
  let logoUrl = "";
  try{
    const rows = await pgFetch("site_settings?select=logo_url&id=eq.1");
    logoUrl = (rows && rows[0]) ? (rows[0].logo_url||"") : "";
  }catch(e){}
  wrap.innerHTML = `
    <div class="panel">
      <h3>Site logo</h3>
      <p class="hint" style="margin-top:0;margin-bottom:12px;">Shows in the buyer app's header, reserved at a 16:4 ratio.</p>
      <div class="field"><label>Logo image link</label><input id="st_logo" value="${escapeHtml(logoUrl)}" placeholder="https://..."></div>
      <button class="btn btn-primary" id="stSaveBtn">Save</button>
    </div>
    <div class="panel">
      <h3>Buyer site</h3>
      <p class="hint" style="margin-top:0;">Tracking links generated in this console point to:</p>
      <div class="field"><input id="st_buyer_url" value="${BUYER_SITE_URL}" readonly></div>
    </div>
  `;
  document.getElementById('stSaveBtn').addEventListener('click', async ()=>{
    const url = document.getElementById('st_logo').value.trim();
    try{
      await pgFetch("site_settings", {method:"POST", headers:{"Prefer":"resolution=merge-duplicates,return=minimal"}, body: JSON.stringify({id:1, logo_url:url})});
      toast("Logo updated.");
    }catch(e){ toast("Couldn't save: " + e.message, true); }
  });
}
</script>
</body>
</html>
