  const rows = filteredOrders.map(o => [
    '#'+o.order_number, o.order_code, o.product_title, o.buyer_name, o.mobile,
    o.quantity||1, '₹'+Number(o.total_price||o.price), new Date(o.created_at).toLocaleDateString(),
    o.expected_delivery||'—', o.delivered_at ? new Date(o.delivered_at).toLocaleDateString() : '—', o.status
  ]);
  doc.autoTable({
    startY: 22,
    head: [['#','Code','Product','Buyer','Mobile','Qty','Total','Placed','Delivery date','Delivered','Status']],
    body: rows, styles: { fontSize: 7 }
  });
  doc.save('kitque-orders-export.pdf');
}

function exportOrdersCSV(){
  const headers = ['Order #','Code','Product','Size','Buyer','Mobile','Email','Address','Village','District','State','Qty','Total','Placed','Delivery date','Delivered at','Status'];
  const csvEscape = v => `"${String(v==null?'':v).replace(/"/g,'""')}"`;
  const lines = [headers.map(csvEscape).join(',')];
  filteredOrders.forEach(o=>{
    lines.push([
      o.order_number, o.order_code, o.product_title, o.size||'', o.buyer_name, o.mobile, o.email||'',
      o.address, o.village, o.district, o.state, o.quantity||1, Number(o.total_price||o.price),
      new Date(o.created_at).toLocaleDateString(), o.expected_delivery||'', o.delivered_at ? new Date(o.delivered_at).toLocaleDateString() : '', o.status
    ].map(csvEscape).join(','));
  });
  const blob = new Blob([lines.join('\n')], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'kitque-orders-export.csv';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

