<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kitque Console — Admin &amp; Seller</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
  :root{
    --bg:#0E1310;
    --panel:#161C18;
    --panel2:#1D2420;
    --line:#2A332C;
    --text:#EDEFE9;
    --dim:#8B9488;
    --brand:#4CC490;
    --brand-dim:rgba(76,196,144,.14);
    --amber:#E8A33D;
    --amber-dim:rgba(232,163,61,.14);
    --danger:#E0685A;
    --danger-dim:rgba(224,104,90,.14);
    --ok:#6FCF97;
    --radius:12px;
    --radius-sm:8px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);color:var(--text);
    font-family:'Manrope',sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .mono{font-family:'JetBrains Mono',monospace;}
  h1,h2,h3{font-family:'Fraunces',serif;font-weight:600;margin:0;}
  button{font-family:inherit;cursor:pointer;}
  a{color:inherit;}

  /* ---------- login ---------- */
  #loginScreen{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;}
  .login-card{width:100%;max-width:400px;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:38px 34px;}
  .login-eyebrow{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:2.5px;color:var(--brand);text-transform:uppercase;}
  .login-title{font-family:'Fraunces',serif;font-size:27px;font-weight:600;margin:10px 0 26px;}
  .field{margin-bottom:15px;}
  .field label{display:block;font-size:12px;color:var(--dim);margin-bottom:6px;font-weight:600;}
  .field input,.field select,.field textarea{
    width:100%;padding:11px 13px;background:var(--panel2);border:1px solid var(--line);border-radius:var(--radius-sm);
    color:var(--text);font-family:inherit;font-size:14px;outline:none;
  }
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--brand);}
  .btn{padding:12px 16px;border-radius:var(--radius-sm);border:none;font-weight:700;font-size:14px;width:100%;text-align:center;}
  .btn-primary{background:var(--brand);color:#06140D;}
  .btn-primary:hover{filter:brightness(1.08);}
  .btn-primary:disabled{opacity:.5;cursor:not-allowed;}
  .btn-ghost{background:transparent;border:1px solid var(--line);color:var(--text);}
  .btn-ghost:hover{border-color:var(--brand);color:var(--brand);}
  .btn-danger{background:var(--danger-dim);color:var(--danger);border:1px solid rgba(224,104,90,.35);}
  .btn-sm{width:auto;padding:8px 13px;font-size:12.5px;}
  .errline{color:var(--danger);font-size:12.5px;margin-top:12px;}

  /* ---------- shell ---------- */
  #app{display:none;}
  #app.open{display:block;}
  header{
    position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;
    padding:16px 26px;background:var(--panel);border-bottom:1px solid var(--line);flex-wrap:wrap;gap:12px;
  }
  .brand{font-family:'Fraunces',serif;font-weight:600;font-size:18px;display:flex;align-items:center;gap:9px;}
  .brand .dot{width:8px;height:8px;border-radius:50%;background:var(--brand);box-shadow:0 0 8px var(--brand);}
  .brand .console{color:var(--dim);font-weight:500;font-size:13px;margin-left:2px;}
  .header-right{display:flex;align-items:center;gap:14px;}
  .who{font-size:12px;color:var(--dim);font-family:'JetBrains Mono',monospace;}
  .role-pill{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:3px 9px;border-radius:999px;background:var(--brand-dim);color:var(--brand);}

  main{max-width:1200px;margin:0 auto;padding:26px;}

  .stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:24px;}
  .stat-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;}
  .stat-label{font-size:10.5px;color:var(--dim);text-transform:uppercase;letter-spacing:1px;font-weight:600;}
  .stat-value{font-family:'Fraunces',serif;font-size:26px;font-weight:600;margin-top:6px;}
  .stat-value.brand{color:var(--brand);}
  .stat-value.amber{color:var(--amber);}
  .stat-value.danger{color:var(--danger);}

  .tabs{display:flex;gap:4px;margin-bottom:20px;border-bottom:1px solid var(--line);align-items:center;justify-content:space-between;}
  .tabs-left{display:flex;gap:4px;overflow-x:auto;}
  .tab-btn{background:none;border:none;color:var(--dim);padding:11px 16px;font-size:13px;font-weight:600;white-space:nowrap;
    border-bottom:2px solid transparent;margin-bottom:-1px;}
  .tab-btn.active{color:var(--brand);border-bottom-color:var(--brand);}
  .refresh-btn{background:none;border:none;color:var(--dim);padding:8px;font-size:16px;flex-shrink:0;}
  .refresh-btn:hover{color:var(--brand);}
  .refresh-btn.spinning{animation:spin .7s linear infinite;}
  @keyframes spin{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}

  .panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:18px;}
  .panel h3{font-size:15px;margin-bottom:14px;}
  .panel .hint{font-size:12px;color:var(--dim);line-height:1.6;margin-top:10px;}

  .field-row{display:flex;gap:10px;}
  .field-row .field{flex:1;}
  .checkbox-row{display:flex;align-items:center;gap:8px;margin-bottom:12px;font-size:13px;font-weight:600;color:var(--dim);}
  .checkbox-row input{width:16px;height:16px;accent-color:var(--brand);}

  /* ---------- filters ---------- */
  .filter-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;align-items:center;}
  .filter-row select,.filter-row input{
    padding:9px 11px;background:var(--panel2);border:1px solid var(--line);border-radius:var(--radius-sm);
    color:var(--text);font-size:12.5px;font-family:'JetBrains Mono',monospace;
  }
  .filter-row input#fltSearch{min-width:200px;flex:1;}

  /* ---------- link builder ---------- */
  .link-builder{display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;background:var(--panel2);border:1px solid var(--line);border-radius:var(--radius-sm);padding:12px;margin-bottom:16px;}
  .link-builder .field{margin-bottom:0;flex:1;min-width:140px;}

  /* ---------- table ---------- */
  .table-scroll{overflow-x:auto;border-radius:var(--radius-sm);border:1px solid var(--line);}
  table.data-table{width:100%;min-width:1040px;border-collapse:collapse;font-size:12.5px;}
  table.data-table th,table.data-table td{padding:11px 13px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap;}
  table.data-table th{background:var(--panel2);color:var(--dim);text-transform:uppercase;font-size:10px;letter-spacing:.5px;font-weight:700;}
  table.data-table tr:hover td{background:rgba(76,196,144,.03);}
  .ordno{font-family:'Fraunces',serif;font-weight:600;font-size:14px;color:var(--brand);}
  .pill{font-family:'JetBrains Mono',monospace;font-size:10px;padding:3px 10px;border-radius:999px;text-transform:uppercase;font-weight:600;display:inline-block;}
  .pill-Confirmed{background:var(--brand-dim);color:var(--brand);}
  .pill-Shipped{background:var(--amber-dim);color:var(--amber);}
  .pill-Delivered{background:rgba(111,207,151,.15);color:var(--ok);}
  .pill-Cancelled{background:var(--danger-dim);color:var(--danger);}
  table.data-table select,table.data-table input[type=date]{
    padding:6px 8px;background:var(--panel2);border:1px solid var(--line);border-radius:6px;
    color:var(--text);font-size:11.5px;font-family:'JetBrains Mono',monospace;
  }
  .delivered-note{font-size:11px;color:var(--ok);}
  .empty-state{color:var(--dim);font-size:13px;padding:26px 0;text-align:center;}
  .row-acts{display:flex;gap:6px;}
  .icon-btn{background:var(--panel2);border:1px solid var(--line);border-radius:6px;padding:6px 9px;font-size:12px;color:var(--text);}
  .icon-btn:hover{border-color:var(--brand);color:var(--brand);}
  .low-stock{background:var(--amber-dim);color:var(--amber);}
  .out-stock{background:var(--danger-dim);color:var(--danger);}

  /* ---------- product list ---------- */
  .plist{display:flex;flex-direction:column;gap:9px;}
  .prow{display:flex;gap:11px;align-items:center;background:var(--panel2);border:1px solid var(--line);border-radius:var(--radius-sm);padding:10px;}
  .prow img{width:44px;height:44px;border-radius:7px;object-fit:cover;background:var(--line);flex-shrink:0;}
  .prow .info{flex:1;min-width:0;}
  .prow .info .t{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .prow .info .p{font-size:11.5px;color:var(--dim);font-family:'JetBrains Mono',monospace;display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
  .prow .acts{display:flex;gap:6px;flex-shrink:0;}

  .img-input-row{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
  .img-input-row input[type=radio]{flex:0 0 auto;width:17px;height:17px;accent-color:var(--brand);}
  .img-input-row input[type=text]{flex:1;}

  /* ---------- modal ---------- */
  .modal-overlay{position:fixed;inset:0;background:rgba(6,10,7,.6);z-index:60;display:flex;align-items:center;justify-content:center;
    opacity:0;pointer-events:none;transition:opacity .18s;padding:20px;}
  .modal-overlay.open{opacity:1;pointer-events:auto;}
  .modal-box{width:100%;max-width:460px;max-height:88vh;overflow-y:auto;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:22px;}
  .modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}
  .modal-head h3{font-size:16px;}
  .modal-close{width:28px;height:28px;border-radius:50%;border:1px solid var(--line);background:var(--panel2);color:var(--dim);}
  .kv{display:flex;justify-content:space-between;gap:10px;font-size:12.5px;padding:7px 0;border-bottom:1px solid var(--line);}
  .kv span:first-child{color:var(--dim);flex-shrink:0;}
  .kv span:last-child{font-weight:600;text-align:right;}

  .toast{
    position:fixed;bottom:26px;left:50%;transform:translateX(-50%);
    background:var(--panel2);border:1px solid var(--line);color:var(--text);padding:12px 20px;border-radius:999px;
    font-size:13px;font-weight:600;opacity:0;pointer-events:none;transition:opacity .25s;z-index:50;max-width:90vw;text-align:center;
  }
  .toast.show{opacity:1;}
  .toast.err{border-color:rgba(224,104,90,.4);color:var(--danger);}
</style>
</head>
<body>

<div id="loginScreen">
  <div class="login-card">
    <div class="login-eyebrow">Kitque Console</div>
    <div class="login-title">Sign in</div>
    <div class="field"><label>Email</label><input type="email" id="loginEmail" placeholder="you@email.com" autocomplete="username"></div>
    <div class="field"><label>Password</label><input type="password" id="loginPassword" placeholder="••••••••" autocomplete="current-password"></div>
    <button class="btn btn-primary" id="loginBtn">Sign in</button>
    <div id="loginError" class="errline"></div>
    <p class="hint">Admin and seller accounts only. Sign up as a regular customer first at kitque.vercel.app, then ask an admin to upgrade your role.</p>
  </div>
</div>

<div id="app">
  <header>
    <div class="brand"><span class="dot"></span>Kitque <span class="console">Console</span></div>
    <div class="header-right">
      <span class="role-pill" id="rolePill"></span>
      <span class="who mono" id="whoAmI"></span>
      <button class="btn btn-ghost btn-sm" id="logoutBtn">Sign out</button>
    </div>
  </header>

  <main>
    <div class="stats-row" id="statsRow"></div>

    <div class="tabs">
      <div class="tabs-left" id="tabs"></div>
      <button class="refresh-btn" id="refreshBtn" title="Refresh data">⟳</button>
    </div>
    <div id="tabContent"></div>
  </main>
</div>

<div class="modal-overlay" id="detailModal">
  <div class="modal-box">
    <div class="modal-head">
      <h3 id="detailModalTitle">Order details</h3>
      <button class="modal-close" id="detailModalClose">✕</button>
    </div>
    <div id="detailModalBody"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const SUPABASE_URL = "https://dnkcfluxdaefdzzxiwyi.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRua2NmbHV4ZGFlZmR6enhpd3lpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU0NjYzMDEsImV4cCI6MjEwMTA0MjMwMX0.WuPtSaXs9s8j1NjoIysUMNG89KSZn94cP45fm5qiZ-4";
const BUYER_SITE_URL = "https://kitque.vercel.app";

let session = null;
let profile = null;
let allProducts = [];
let allCategories = [];
let allOrders = [];
let filteredOrders = [];
let editingProductId = null;
let activeTab = "orders";

function authHeaders(){
  const h = { "apikey": SUPABASE_ANON_KEY, "Content-Type":"application/json" };
  h["Authorization"] = "Bearer " + (session ? session.access_token : SUPABASE_ANON_KEY);
  return h;
}
async function pgFetch(path, opts={}){
  const res = await fetch(`${SUPABASE_URL}/rest/v1/${path}`, { ...opts, headers:{ ...authHeaders(), ...(opts.headers||{}) } });
  if(!res.ok){ const t = await res.text(); throw new Error(t || res.statusText); }
  const text = await res.text();
  return text ? JSON.parse(text) : null;
}
async function rpcFetch(fn, body){
  const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/${fn}`, { method:"POST", headers: authHeaders(), body: JSON.stringify(body) });
  const data = await res.json().catch(()=>null);
  if(!res.ok){ throw new Error((data && (data.message||data.error_description)) || res.statusText); }
  return data;
}
async function authFetch(path, body){
  const res = await fetch(`${SUPABASE_URL}/auth/v1/${path}`, {
    method:"POST", headers:{ "apikey": SUPABASE_ANON_KEY, "Content-Type":"application/json" }, body: JSON.stringify(body)
  });
  const data = await res.json();
  if(!res.ok) throw new Error(data.error_description || data.msg || data.error || "Something went wrong");
  return data;
}
function escapeHtml(s){
  return String(s==null?"":s).replace(/[&<>"']/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}
function toast(msg, isErr){
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.toggle('err', !!isErr); t.classList.add('show');
  clearTimeout(toast._t);
  toast._t = setTimeout(()=>t.classList.remove('show'), 2600);
}
function productImages(p){
  if(Array.isArray(p.images) && p.images.length) return p.images;
  if(p.image_url) return [p.image_url];
  return [];
}
function trackingLink(code, mobile){
  const u = new URL(BUYER_SITE_URL);
  u.searchParams.set('track_code', code);
  u.searchParams.set('track_mobile', mobile);
  return u.toString();
}
async function copyToClipboard(text){
  try{ await navigator.clipboard.writeText(text); return true; }
  catch(e){
    const ta = document.createElement('textarea');
    ta.value = text; ta.style.position='fixed'; ta.style.left='-9999px';
    document.body.appendChild(ta); ta.select();
    try{ document.execCommand('copy'); document.body.removeChild(ta); return true; }
    catch(e2){ document.body.removeChild(ta); return false; }
  }
}

/* ---------------- auth / lockout ---------------- */
document.getElementById('loginBtn').addEventListener('click', doLogin);
document.getElementById('loginPassword').addEventListener('keydown', e=>{ if(e.key==='Enter') doLogin(); });

async function doLogin(){
  const email = document.getElementById('loginEmail').value.trim();
  const password = document.getElementById('loginPassword').value;
  const btn = document.getElementById('loginBtn');
  const err = document.getElementById('loginError');
  err.textContent = '';
  if(!email || !password){ err.textContent = 'Enter email and password.'; return; }

  try{
    const lock = await rpcFetch('check_login_lock', {p_email: email});
    if(lock && lock[0] && lock[0].locked){
      err.textContent = `Too many attempts. Try again in ${lock[0].seconds_left}s.`;
      return;
    }
  }catch(e){ /* if lock-check itself fails, still attempt login below */ }

  btn.disabled = true; btn.textContent = 'Signing in…';
  try{
    const data = await authFetch('token?grant_type=password', {email, password});
    session = { access_token: data.access_token, user: data.user };
    try{ await rpcFetch('clear_login_attempts', {p_email: email}); }catch(e){}
    await fetchMyProfile();
    if(!profile || !['admin','seller'].includes(profile.role)){
      err.textContent = "This account isn't an admin or seller. Ask an admin to upgrade your role.";
      session = null; profile = null;
      btn.disabled = false; btn.textContent = 'Sign in';
      return;
    }
    enterApp();
  }catch(e){
    try{
      const reg = await rpcFetch('register_failed_login', {p_email: email});
      if(reg && reg[0] && reg[0].locked){
        err.textContent = `Too many attempts — locked for 60s.`;
      } else {
        const left = reg && reg[0] ? (5 - reg[0].attempts) : null;
        err.textContent = 'Invalid email or password.' + (left!=null ? ` (${left} attempt${left===1?'':'s'} left)` : '');
      }
    }catch(e2){ err.textContent = 'Invalid email or password.'; }
    btn.disabled = false; btn.textContent = 'Sign in';
  }
}

async function fetchMyProfile(){
  if(!session){ profile = null; return; }
  try{
    const rows = await pgFetch(`profiles?select=*&id=eq.${session.user.id}`);
    profile = (rows && rows[0]) ? rows[0] : null;
  }catch(e){ profile = null; }
}

function enterApp(){
  document.getElementById('loginScreen').style.display = 'none';
  document.getElementById('app').classList.add('open');
  document.getElementById('whoAmI').textContent = session.user.email;
  document.getElementById('rolePill').textContent = profile.role;
  buildTabs();
  loadAll();
}

document.getElementById('logoutBtn').addEventListener('click', ()=>{
  session = null; profile = null;
  document.getElementById('app').classList.remove('open');
  document.getElementById('loginScreen').style.display = 'flex';
  document.getElementById('loginPassword').value = '';
});

document.getElementById('refreshBtn').addEventListener('click', async ()=>{
  const btn = document.getElementById('refreshBtn');
  btn.classList.add('spinning');
  await loadAll();
  btn.classList.remove('spinning');
  toast('Refreshed.');
});

document.getElementById('detailModalClose').addEventListener('click', closeDetailModal);
document.getElementById('detailModal').addEventListener('click', e=>{ if(e.target.id==='detailModal') closeDetailModal(); });
function closeDetailModal(){ document.getElementById('detailModal').classList.remove('open'); }

/* ---------------- tabs / data ---------------- */
function buildTabs(){
  const isAdmin = profile.role === 'admin';
  const tabsEl = document.getElementById('tabs');
  const defs = [
    {id:'orders', label:'Orders'},
    {id:'products', label: isAdmin ? 'All products' : 'My products'},
  ];
  if(isAdmin){
    defs.push({id:'categories', label:'Categories'});
    defs.push({id:'sellers', label:'Sellers & roles'});
    defs.push({id:'settings', label:'Settings'});
  }
  tabsEl.innerHTML = defs.map(d=>`<button class="tab-btn${d.id===activeTab?' active':''}" data-t="${d.id}">${d.label}</button>`).join('');
  tabsEl.querySelectorAll('button').forEach(b=>b.addEventListener('click', ()=>{
    activeTab = b.dataset.t;
    tabsEl.querySelectorAll('button').forEach(x=>x.classList.toggle('active', x===b));
    renderTab();
  }));
}

async function loadAll(){
  // Client-side safety net: catch any orders whose delivery date has
  // passed but weren't yet flipped by the nightly database job.
  try{ await rpcFetch('auto_mark_delivered', {}); }catch(e){ /* ignore if it fails — nightly job still covers it */ }
  await Promise.all([loadCategories(), loadProducts(), loadOrders()]);
  renderStats();
  renderTab();
}

async function loadCategories(){
  try{ allCategories = await pgFetch("categories?select=*&order=name.asc"); }catch(e){ allCategories = []; }
}
async function loadProducts(){
  try{ allProducts = await pgFetch("products?select=*&order=created_at.desc"); }catch(e){ allProducts = []; }
}
async function loadOrders(){
  const isAdmin = profile.role === 'admin';
  try{
    if(isAdmin){
      allOrders = await pgFetch("orders?select=*&order=order_number.desc");
    } else {
      const myIds = allProducts.filter(p=>p.seller_id===session.user.id).map(p=>p.id);
      allOrders = myIds.length ? await pgFetch(`orders?select=*&product_id=in.(${myIds.join(',')})&order=order_number.desc`) : [];
    }
  }catch(e){ console.error(e); allOrders = []; }
  filteredOrders = allOrders;
}

function renderStats(){
  const todayStr = new Date().toDateString();
  const today = allOrders.filter(o => new Date(o.created_at).toDateString() === todayStr).length;
  const pending = allOrders.filter(o => o.status === 'Confirmed').length;
  const shipped = allOrders.filter(o => o.status === 'Shipped').length;
  const delivered = allOrders.filter(o => o.status === 'Delivered').length;
  const cancelled = allOrders.filter(o => o.status === 'Cancelled').length;
  const revenue = allOrders.filter(o=>o.status!=='Cancelled').reduce((s,o)=>s+Number(o.total_price||o.price||0),0);
  const nonCancelled = allOrders.filter(o=>o.status!=='Cancelled').length;
  const aov = nonCancelled ? Math.round(revenue / nonCancelled) : 0;
  document.getElementById('statsRow').innerHTML = `
    <div class="stat-card"><div class="stat-label">Today</div><div class="stat-value brand">${today}</div></div>
    <div class="stat-card"><div class="stat-label">Pending</div><div class="stat-value amber">${pending}</div></div>
